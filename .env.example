# Copy to .env.local (never commit .env.local) and fill in from
# Supabase Dashboard -> Project Settings -> API.
#
# Both values are public by design: they ship to the browser, and Row Level
# Security in supabase/migrations decides what each signed-in user can touch.
# NEVER put the service_role / secret key in this app or in any NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Older projects show an "anon" key instead; either variable works:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Automation emails (optional, server-only) ---
# Used by the "Send Email Notification" step via /api/automation/email.
# These are secrets: never prefix them with NEXT_PUBLIC_. On Vercel, add them
# as Sensitive environment variables. Without them, email steps fail with a
# clear "not set up" message and everything else keeps working.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# AUTOMATION_EMAIL_FROM="Cali's Task <automations@your-verified-domain.com>"
